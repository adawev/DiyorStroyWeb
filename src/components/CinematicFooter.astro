---
// Kinematik footer — React komponentining Astro + GSAP portu.
// Bir ekranli "parda" bo'lim: aurora nur, to'r, ulkan fon matni,
// diagonal marquee, magnit tugmalar va pastki qator.
import Icon from './Icon.astro';
import { site } from '../data/site.js';

const year = new Date().getFullYear();

const marquee = [
  'Rasmiy brendlar',
  'Ulgurji narx',
  'Yetkazib berish',
  'Sertifikatlangan tovar',
  'Har kuni 07:00 — 20:00',
];
---

<div class="cf-wrap">
  <footer class="cf">
    <div class="cf__aurora" aria-hidden="true"></div>
    <div class="cf__grid" aria-hidden="true"></div>
    <div class="cf__giant" aria-hidden="true" data-cf-giant>DIYOR STROY</div>

    <div class="cf__marquee" aria-hidden="true">
      <div class="cf__marquee-track">
        {
          [0, 1].map(() => (
            <div class="cf__marquee-group">
              {marquee.map((m) => (
                <>
                  <span>{m}</span>
                  <i>✦</i>
                </>
              ))}
            </div>
          ))
        }
      </div>
    </div>

    <div class="cf__body">
      <h2 class="cf__title" data-cf-title>Aniq narxni bir qo'ng'iroqda bilasiz</h2>

      <div class="cf__links" data-cf-links>
        <div class="cf__row">
          <a class="cf-pill cf-pill--lg tnum" href={site.phoneHref} data-magnetic>
            <Icon name="phone" size={20} />
            {site.phone}
          </a>
          <a
            class="cf-pill cf-pill--lg"
            href={site.telegramChat}
            target="_blank"
            rel="noopener"
            data-magnetic
          >
            <Icon name="telegram" size={20} />
            Telegramda yozish
          </a>
        </div>

        <div class="cf__row cf__row--sm">
          <a class="cf-pill" href={site.instagram} target="_blank" rel="noopener" data-magnetic>
            <Icon name="instagram" size={16} /> Instagram
          </a>
          <a class="cf-pill" href={site.googleMaps} target="_blank" rel="noopener" data-magnetic>
            <Icon name="route" size={16} /> Google xarita
          </a>
          <a class="cf-pill" href={site.yandexMaps} target="_blank" rel="noopener" data-magnetic>
            <Icon name="route" size={16} /> Yandex xarita
          </a>
        </div>
      </div>
    </div>

    <div class="cf__bottom">
      <p class="cf__copy">© {year} Diyor Stroy · {site.address}</p>

      <div class="cf-pill cf-pill--static tnum">
        <Icon name="clock" size={15} />
        {site.hours} · {site.hoursNote}
      </div>

      <button class="cf-pill cf-pill--icon" type="button" data-cf-top data-magnetic aria-label="Yuqoriga">
        <Icon name="arrow-down" size={18} />
      </button>
    </div>
  </footer>
</div>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const wrap = document.querySelector<HTMLElement>('.cf-wrap');

  document.querySelector<HTMLElement>('[data-cf-top]')?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
  });

  if (wrap && !reduce) {
    // Fon matni skroll bilan sekin ko'tariladi.
    gsap.fromTo(
      '[data-cf-giant]',
      { y: '10vh', scale: 0.86, opacity: 0 },
      {
        y: '0vh',
        scale: 1,
        opacity: 1,
        ease: 'power1.out',
        scrollTrigger: { trigger: wrap, start: 'top 80%', end: 'bottom bottom', scrub: 1 },
      },
    );

    // Sarlavha va havolalar navbat bilan chiqadi.
    gsap.fromTo(
      ['[data-cf-title]', '[data-cf-links]'],
      { y: 50, opacity: 0 },
      {
        y: 0,
        opacity: 1,
        stagger: 0.15,
        ease: 'power3.out',
        scrollTrigger: { trigger: wrap, start: 'top 45%', end: 'bottom bottom', scrub: 1 },
      },
    );

    // Magnit tugmalar — faqat sichqoncha bor qurilmalarda.
    if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      document.querySelectorAll<HTMLElement>('[data-magnetic]').forEach((el) => {
        el.addEventListener('pointermove', (e) => {
          const r = el.getBoundingClientRect();
          const x = e.clientX - r.left - r.width / 2;
          const y = e.clientY - r.top - r.height / 2;
          gsap.to(el, { x: x * 0.3, y: y * 0.35, scale: 1.04, duration: 0.4, ease: 'power2.out' });
        });
        el.addEventListener('pointerleave', () => {
          gsap.to(el, { x: 0, y: 0, scale: 1, duration: 1.1, ease: 'elastic.out(1, 0.35)' });
        });
      });
    }
  } else {
    document.querySelectorAll<HTMLElement>('[data-cf-giant], [data-cf-title], [data-cf-links]').forEach((el) => {
      el.style.opacity = '1';
    });
  }
</script>

<style>
  .cf-wrap {
    position: relative;
    width: 100%;
    height: 100svh;
    clip-path: inset(0);
  }

  .cf {
    position: fixed;
    inset: auto 0 0 0;
    height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    background: var(--color-bg-900);
    color: var(--color-fg-100);
  }

  /* ---- fon qatlamlari ---- */
  .cf__aurora {
    position: absolute;
    z-index: 0;
    left: 50%;
    top: 52%;
    width: 84vw;
    height: 58vh;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    filter: blur(90px);
    background: radial-gradient(
      circle at 50% 50%,
      rgb(228 87 46 / 0.28) 0%,
      rgb(228 87 46 / 0.1) 42%,
      transparent 70%
    );
    animation: cf-breathe 9s ease-in-out infinite alternate;
    pointer-events: none;
  }

  .cf__grid {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-size: 64px 64px;
    background-image:
      linear-gradient(to right, rgb(255 255 255 / 0.035) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(255 255 255 / 0.035) 1px, transparent 1px);
    mask-image: linear-gradient(to bottom, transparent, #000 28%, #000 72%, transparent);
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 28%, #000 72%, transparent);
    pointer-events: none;
  }

  .cf__giant {
    position: absolute;
    z-index: 0;
    left: 50%;
    bottom: -3vh;
    transform: translateX(-50%);
    white-space: nowrap;
    font-family: var(--display);
    font-size: 13vw;
    line-height: 0.78;
    font-weight: 700;
    letter-spacing: -0.05em;
    color: transparent;
    -webkit-text-stroke: 1px rgb(255 255 255 / 0.07);
    background: linear-gradient(180deg, rgb(255 255 255 / 0.1) 0%, transparent 62%);
    -webkit-background-clip: text;
    background-clip: text;
    user-select: none;
    pointer-events: none;
  }

  /* ---- diagonal marquee ---- */
  .cf__marquee {
    position: absolute;
    z-index: 1;
    top: 12%;
    left: 0;
    width: 100%;
    padding: 14px 0;
    overflow: hidden;
    border-block: 1px solid var(--line-2);
    background: rgb(10 10 11 / 0.6);
    backdrop-filter: blur(10px);
    transform: rotate(-2deg) scale(1.12);
    box-shadow: 0 24px 60px -30px rgb(0 0 0 / 0.9);
  }
  .cf__marquee-track {
    display: flex;
    width: max-content;
    animation: cf-scroll 42s linear infinite;
  }
  .cf__marquee-group {
    display: flex;
    align-items: center;
  }
  .cf__marquee span,
  .cf__marquee i {
    padding-inline: 22px;
    font-size: clamp(11px, 1vw, 13px);
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-fg-500);
    font-style: normal;
  }
  .cf__marquee i { color: var(--color-accent); padding-inline: 0; }

  /* ---- markaz ---- */
  .cf__body {
    position: relative;
    z-index: 2;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(32px, 5vh, 56px);
    padding: 14vh clamp(20px, 5vw, 88px) 0;
    width: 100%;
    max-width: 1100px;
    margin-inline: auto;
    text-align: center;
  }

  .cf__title {
    font-family: var(--display);
    font-size: clamp(30px, 5.4vw, 76px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.05em;
    text-wrap: balance;
    background: linear-gradient(180deg, var(--color-fg-100) 0%, rgb(245 243 239 / 0.6) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 0 24px rgb(255 255 255 / 0.1));
  }

  .cf__links { display: grid; gap: 14px; justify-items: center; width: 100%; }
  .cf__row { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }

  /* ---- shisha "pill" ---- */
  .cf-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 13px 22px;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.1);
    background: linear-gradient(145deg, rgb(255 255 255 / 0.05) 0%, rgb(255 255 255 / 0.015) 100%);
    box-shadow:
      0 10px 30px -10px rgb(0 0 0 / 0.6),
      inset 0 1px 1px rgb(255 255 255 / 0.09);
    backdrop-filter: blur(14px);
    font-size: 13px;
    font-weight: 600;
    color: var(--color-fg-300);
    transition:
      background 0.4s var(--ease-out-expo),
      border-color 0.4s var(--ease-out-expo),
      color 0.4s var(--ease-out-expo);
  }
  .cf-pill :global(svg) { color: var(--color-accent); flex: none; }
  a.cf-pill:hover,
  button.cf-pill:hover {
    color: var(--color-fg-100);
    border-color: rgb(255 255 255 / 0.24);
    background: linear-gradient(145deg, rgb(255 255 255 / 0.1) 0%, rgb(255 255 255 / 0.03) 100%);
  }

  .cf-pill--lg {
    padding: 18px 32px;
    font-size: clamp(14px, 1.3vw, 17px);
    font-weight: 700;
    color: var(--color-fg-100);
  }
  .cf-pill--static { cursor: default; }
  .cf-pill--icon { padding: 0; width: 48px; height: 48px; justify-content: center; }
  .cf-pill--icon :global(svg) {
    color: var(--color-fg-300);
    transform: rotate(180deg);
    transition: transform 0.3s var(--ease-out-expo);
  }
  .cf-pill--icon:hover :global(svg) { transform: rotate(180deg) translateY(-6px); }

  /* ---- pastki qator ---- */
  .cf__bottom {
    position: relative;
    z-index: 3;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 0 clamp(20px, 5vw, 88px) 34px;
  }
  .cf__copy {
    order: 2;
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--color-fg-500);
  }
  .cf__bottom .cf-pill--static { order: 1; font-size: 12px; }
  .cf__bottom .cf-pill--icon { order: 3; }

  @keyframes cf-breathe {
    0% { transform: translate(-50%, -50%) scale(1); opacity: 0.65; }
    100% { transform: translate(-50%, -50%) scale(1.12); opacity: 1; }
  }
  @keyframes cf-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (max-width: 900px) {
    /* Mobilda "parda" o'rniga oddiy oqim — kontent kesilib qolmasin. */
    .cf-wrap { height: auto; clip-path: none; }
    .cf {
      position: relative;
      inset: auto;
      height: auto;
      min-height: 100svh;
      overflow-x: clip;
      overflow-y: visible;
      padding-bottom: 150px;
    }
    .cf__marquee {
      position: static;
      margin-top: 96px;
      transform: rotate(-2deg) scale(1.16);
    }
    .cf__body {
      padding: clamp(56px, 12vh, 110px) 20px 0;
      gap: 28px;
    }
    .cf__giant {
      font-size: 25vw;
      line-height: 0.86;
      white-space: normal;
      bottom: 88px;
      left: 0;
      width: 100%;
      transform: none;
      text-align: center;
    }
    .cf__bottom {
      justify-content: center;
      text-align: center;
      padding: clamp(48px, 9vh, 90px) 20px 0;
    }
    .cf__copy { order: 3; flex: 1 0 100%; }
    .cf__bottom .cf-pill--icon { order: 2; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cf__aurora, .cf__marquee-track { animation: none; }
  }
</style>
