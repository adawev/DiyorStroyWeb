---
import { variants } from '../data/site.js';
interface Props { current: string }
const { current } = Astro.props;
---

<div class="switcher" role="group" aria-label="Sayt varianti">
  <span class="switcher__label">Variant</span>
  {
    variants.map((v) => (
      <a
        href={v.href}
        class:list={['switcher__item', { 'is-active': v.id === current }]}
        aria-current={v.id === current ? 'page' : undefined}
        title={v.note}
      >
        <span class="switcher__id">{v.id.toUpperCase()}</span>
        <span class="switcher__name">{v.name}</span>
      </a>
    ))
  }
</div>

<style>
  .switcher {
    position: fixed;
    z-index: 90;
    left: 50%;
    bottom: 16px;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 5px 5px 5px 14px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: rgb(10 10 11 / 0.72);
    backdrop-filter: blur(18px);
    box-shadow: 0 12px 32px -12px rgb(0 0 0 / 0.8);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .switcher__label {
    color: var(--color-fg-500);
    padding-right: 6px;
  }

  .switcher__item {
    display: flex;
    align-items: baseline;
    gap: 7px;
    padding: 9px 14px;
    border-radius: 999px;
    color: var(--color-fg-300);
    transition:
      background 0.2s var(--ease-out-expo),
      color 0.2s var(--ease-out-expo);
  }

  .switcher__item:hover {
    background: rgb(255 255 255 / 0.08);
    color: var(--color-fg-100);
  }

  .switcher__item.is-active {
    background: var(--color-fg-100);
    color: var(--color-bg-900);
  }

  .switcher__name {
    color: inherit;
    opacity: 0.65;
    letter-spacing: 0.06em;
  }

  @media (max-width: 720px) {
    .switcher {
      bottom: 76px;
      padding: 4px 4px 4px 10px;
      font-size: 10px;
    }
    .switcher__item {
      padding: 8px 10px;
    }
    .switcher__name {
      display: none;
    }
  }
</style>
