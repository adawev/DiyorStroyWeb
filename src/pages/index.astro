---
import '@fontsource-variable/unbounded';
import '@fontsource-variable/manrope';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import OpenStatus from '../components/OpenStatus.astro';
import CategoryCarousel from '../components/CategoryCarousel.astro';
import CinematicFooter from '../components/CinematicFooter.astro';
import { site, stats, advantages, services, brands, faq } from '../data/site.js';

import logoWhite from '../../images/logoWhite.png';
import heroArt from '../../images/hero/hero-ai.png';

const photoMods = import.meta.glob<ImageMetadata>('../../images/photo*.jpg', {
  eager: true,
  import: 'default',
});
const photos = Object.keys(photoMods)
  .sort((a, b) => a.localeCompare(b, 'en', { numeric: true }))
  .map((k) => photoMods[k]);

const brandMods = import.meta.glob<ImageMetadata>('../../images/brands-mono/*.png', {
  eager: true,
  import: 'default',
});
const brandLogos = brands.map((b) => ({ ...b, img: brandMods[`../../images/brands-mono/${b.file.replace(/\.\w+$/, '.png')}`] }));
const galleryPanels = photos.slice(0, 4);
// Yandex Xarita — O'zbekiston manzillari va nomlari uchun aniqroq.
const ll = `${site.coords.lng}%2C${site.coords.lat}`;
const mapSrc = `https://yandex.uz/map-widget/v1/?ll=${ll}&z=17&pt=${site.coords.lng},${site.coords.lat},pm2rdm&lang=uz_UZ`;
---

<Base
  bodyClass="site"
  title="Diyor Stroy — Samarqandda qurilish mollari do'koni"
  description="6 yil, 30 000+ mijoz, 5000+ mahsulot turi. Xalil Sulton 150, Samarqand. Har kuni 07:00–20:00. +998 97 646 10 00."
>
  <a class="skip" href="#toifalar">Kontentga o'tish</a>

  <div class="topbar">
    <a class="topbar__brand" href="/">
      <Image src={logoWhite} alt="Diyor Stroy" widths={[130, 260]} sizes="130px" />
    </a>
    <span class="topbar__status"><OpenStatus /></span>
    <a class="topbar__call" href={site.phoneHref}>
      <Icon name="phone" size={17} />
      <span class="tnum">{site.phone}</span>
    </a>
  </div>

  <!-- ============ HERO ============ -->
  <header class="hero panel" data-hero>
    <div class="hero__bg" data-parallax>
      <Image
        src={heroArt}
        alt="Sement, gipsokarton, bo'yoq, santexnika, elektr mollari va asbob-uskuna — Diyor Stroy assortimenti"
        widths={[900, 1500, 2200]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="hero__scrim"></div>

    <div class="hero__body">
      <p class="tagline" data-reveal>Samarqand · Xalil Sulton 150 · 07:00 dan</p>
      <h1>
        <span data-rise>Qurilish</span>
        <span data-rise style="--reveal-delay:90ms">mollari</span>
      </h1>
      <p class="hero__lead" data-reveal style="--reveal-delay:160ms">
        5000+ mahsulot turi. To'g'ridan-to'g'ri ishlab chiqaruvchidan —
        oraliq ustama yo'q, tovar sertifikatlangan.
      </p>
      <div class="hero__cta" data-reveal style="--reveal-delay:240ms">
        <a class="btn" href={site.phoneHref} data-magnetic>Qo'ng'iroq qilish <Icon name="arrow" size={18} /></a>
        <a class="btn btn--ghost" href={site.telegramChat} target="_blank" rel="noopener" data-magnetic>
          <Icon name="telegram" size={18} /> Telegram
        </a>
      </div>
    </div>


    <a class="hero__cue" href="#manifest"><span>Pastga</span><Icon name="arrow-down" size={18} /></a>
  </header>

  <div class="flow">
    <!-- ============ MANIFEST ============ -->
    <section class="manifest panel" id="manifest">
      <div class="manifest__lede">
        <p class="manifest__text" data-reveal>
          <span>Arzon va sifatli odatda bir joyda uchramaydi.</span>
          <b>Bizda uchraydi.</b>
        </p>
        <p class="manifest__sub" data-reveal style="--reveal-delay:120ms">
          Sababi oddiy: mahsulot ishlab chiqaruvchi va yirik distribyutorlardan
          to'g'ridan-to'g'ri olinadi — oraliq ustama yo'q.
        </p>
      </div>
      <ol class="manifest__grid" data-stagger>
        {
          advantages.map((a, i) => (
            <li data-reveal style={`--reveal-delay:${i * 90}ms`}>
              <span class="tnum">{String(i + 1).padStart(2, '0')}</span>
              <h3>{a.title}</h3>
              <p>{a.text}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- ============ TOIFALAR ============ -->
    <CategoryCarousel photos={photos} />

    <!-- ============ STATISTIKA ============ -->
    <section class="stats panel" aria-label="Raqamlar">
      <ul data-stagger>
        {
          stats.map((s) => (
            <li data-reveal>
              <span class="stats__v tnum">{s.value}</span>
              <span class="stats__l">{s.label}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- ============ GALEREYA ============ -->
    <section class="shots" id="dokon">
      {
        galleryPanels.map((p, i) => (
          <figure class="shot">
            <div class="shot__img" data-parallax>
              <Image src={p} alt="Diyor Stroy do'koni" widths={[720, 1400]} sizes="100vw" loading="lazy" />
            </div>
            <figcaption data-reveal>
              <span class="tnum">{String(i + 1).padStart(2, '0')}</span>
              {['Rastalar va ombor', 'Santexnika bo\'limi', 'Quruq qorishmalar', 'Asbob-uskuna'][i]}
            </figcaption>
          </figure>
        ))
      }
    </section>

    <!-- ============ BRENDLAR ============ -->
    <section class="brands" id="brendlar">
      <div class="brands__head">
        <h2 data-rise>Rasmiy brendlar</h2>
        <p data-reveal style="--reveal-delay:120ms">Faqat sertifikatlangan, sifat nazoratidan o'tgan mahsulot.</p>
      </div>
      {
        [0, 1].map((row) => (
          <div class="marquee" data-dir={row}>
            <div class="marquee__track">
              {[0, 1].map(() =>
                (row === 0 ? brandLogos.slice(0, 8) : brandLogos.slice(8)).map((b) => (
                  <span><Image src={b.img} alt={b.name} widths={[120, 240]} sizes="120px" loading="lazy" /></span>
                )),
              )}
            </div>
          </div>
        ))
      }
    </section>

    <!-- ============ ULGURJI ============ -->
    <section class="split" id="ulgurji">
      <div class="split__left" data-stagger>
        <p class="tagline tagline--dark" data-reveal>Ulgurji va brigadalar</p>
        <h2 data-rise>Ertalab<br />07:00 dan ochiq</h2>
        <p class="split__lead" data-reveal>
          Brigada ish boshlashidan oldin material olib ulgursin. Katta hajmdagi
          buyurtmalarga alohida chegirma narx.
        </p>
        <ul class="split__services" data-reveal>
          {services.map((s) => <li><b>{s.title}</b> — {s.text}</li>)}
        </ul>
      </div>

      <div class="split__contact" data-stagger>
        <h3 data-reveal>Chegirma narx so'rash</h3>
        <p class="split__contact-lead" data-reveal>
          Kerakli materialni ayting — narxini va bor-yo'qligini shu yerda aytamiz.
        </p>
        <a class="split__phone tnum" data-reveal href={site.phoneHref} data-magnetic="0.15">
          {site.phone}
          <Icon name="arrow" size={26} />
        </a>
        <a class="btn btn--tg" data-reveal href={site.telegramChat} target="_blank" rel="noopener" data-magnetic>
          <Icon name="telegram" size={18} /> Telegramda yozish
        </a>
        <p class="split__contact-note tnum" data-reveal>{site.hours} · {site.hoursNote}</p>
      </div>
    </section>

    <!-- ============ MANZIL ============ -->
    <section class="map" id="manzil" data-map>
      <iframe src={mapSrc} title="Diyor Stroy Yandex xaritada" loading="lazy" allowfullscreen referrerpolicy="no-referrer-when-downgrade"></iframe>
      <button class="map__shield" type="button" data-map-unlock>
        <span>Xaritani ochish uchun bosing</span>
      </button>
        <div class="map__card" data-stagger>
        <h2 data-rise>Qayerdamiz</h2>
        <ul data-reveal>
          <li><Icon name="pin" size={18} /><span>{site.address}</span></li>
          <li><Icon name="clock" size={18} /><span class="tnum">{site.hours} · {site.hoursNote}</span></li>
          <li><Icon name="phone" size={18} /><a href={site.phoneHref} class="tnum">{site.phone}</a></li>
          <li><Icon name="tag" size={18} /><span>{site.payments.join(' · ')}</span></li>
        </ul>
        <div class="map__links" data-reveal>
          <a class="btn btn--ghost" href={site.googleMaps} target="_blank" rel="noopener" data-magnetic="0.2"><Icon name="route" size={16} /> Google</a>
          <a class="btn btn--ghost" href={site.yandexMaps} target="_blank" rel="noopener" data-magnetic="0.2"><Icon name="route" size={16} /> Yandex</a>
        </div>
      </div>
    </section>

    <!-- ============ SAVOLLAR ============ -->
    <section class="faq" id="savollar">
      <h2 data-rise>Savollar</h2>
      <ul data-stagger>
        {
          faq.map((f) => (
            <li data-reveal>
              <details>
                <summary><span>{f.q}</span><i aria-hidden="true"></i></summary>
                <p>{f.a}</p>
              </details>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- ============ FOOTER ============ -->
    <CinematicFooter />
  </div>

  <div class="mobilebar">
    <a href={site.phoneHref}><Icon name="phone" size={19} /> Qo'ng'iroq</a>
    <a href={site.telegramChat} target="_blank" rel="noopener"><Icon name="telegram" size={19} /> Telegram</a>
  </div>

  <script>
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Xarita: bosilgandan keyin interaktiv, sichqoncha chiqsa yana bloklanadi.
    const map = document.querySelector<HTMLElement>('[data-map]');
    if (map) {
      map.querySelector('[data-map-unlock]')?.addEventListener('click', () => {
        map.classList.add('is-live');
      });
      map.addEventListener('pointerleave', () => map.classList.remove('is-live'));
    }

    // Raqamlar ko'rinishga kirganda sanaladi.
    const nums = Array.from(document.querySelectorAll<HTMLElement>('.stats__v'));
    if (nums.length && !reduce) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            const el = e.target as HTMLElement;
            io.unobserve(el);
            const raw = el.textContent || '';
            const digits = raw.replace(/[^\d]/g, '');
            if (!digits || raw.includes(':')) return;
            const target = parseInt(digits, 10);
            const suffix = raw.trim().endsWith('+') ? '+' : '';
            const t0 = performance.now();
            const step = (t: number) => {
              const p = Math.min(1, (t - t0) / 1100);
              const eased = 1 - Math.pow(1 - p, 3);
              const value = Math.round(target * eased);
              el.textContent = value.toLocaleString('ru-RU').replace(/ /g, ' ') + suffix;
              if (p < 1) requestAnimationFrame(step);
            };
            requestAnimationFrame(step);
          });
        },
        { threshold: 0.4 },
      );
      nums.forEach((n) => io.observe(n));
    }

  </script>
</Base>

<style is:global>
  body.site {
    --display: 'Unbounded Variable', 'Manrope Variable', sans-serif;
    font-family: 'Manrope Variable', ui-sans-serif, system-ui, sans-serif;
  }
</style>

<style>
  .skip {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 200;
    padding: 12px 18px;
    background: var(--color-accent);
    color: #fff;
  }
  .skip:focus { left: 12px; top: 12px; }

  .tagline {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-fg-500);
  }
  .tagline--dark { color: rgb(255 255 255 / 0.72); }

  /* ================= TOPBAR ================= */
  .topbar {
    position: fixed;
    z-index: 60;
    inset: 0 0 auto 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 18px clamp(20px, 4vw, 48px);
    background: linear-gradient(to bottom, rgb(10 10 11 / 0.85), transparent);
  }
  .topbar__brand img { width: auto; height: 54px; }
  .topbar__status { display: block; margin-inline: auto; }
  .topbar__call {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 11px 20px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgb(10 10 11 / 0.5);
    backdrop-filter: blur(12px);
    color: var(--color-fg-100);
    font-size: 14px;
    white-space: nowrap;
    transition: border-color 0.2s, background 0.2s;
  }
  .topbar__call :global(svg) { color: var(--color-accent); }
  .topbar__call:hover { border-color: var(--color-accent); background: rgb(228 87 46 / 0.12); }

  section[id],
  header[id] {
    scroll-margin-top: 88px;
  }

  .panel {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
  }

  /* ================= HERO ================= */
  /* Hero yopishib turadi, keyingi bo'limlar uning ustidan surilib chiqadi
     — footerdagi "parda" effektining teskarisi. */
  .hero {
    position: sticky;
    top: 0;
    z-index: 0;
    height: 100svh;
    overflow: clip;
    padding: 120px clamp(20px, 5vw, 88px) 96px;
    transform-origin: 50% 30%;
    will-change: transform, opacity;
  }

  .flow {
    position: relative;
    z-index: 1;
    background: var(--color-bg-900);
  }
  .hero__bg { position: absolute; inset: -4% 0; z-index: 0; }
  .hero__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 78% 62%;
    transform: scale(1.04);
    filter: contrast(1.06) brightness(0.94);
    transition: transform 0.2s linear;
  }
  /* Matn o'qilishi uchun: chapdan qattiq, o'ngda mahsulot ochiq qoladi. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(100deg, var(--color-bg-900) 8%, rgb(10 10 11 / 0.92) 30%, rgb(10 10 11 / 0.35) 56%, transparent 76%),
      linear-gradient(to top, var(--color-bg-900) 0%, transparent 26%),
      linear-gradient(to bottom, rgb(10 10 11 / 0.7) 0%, transparent 22%);
  }
  .hero__body { position: relative; z-index: 3; max-width: 900px; }
  .hero h1 {
    margin-top: 22px;
    display: flex;
    flex-direction: column;
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(46px, 8.4vw, 124px);
    line-height: 0.94;
    letter-spacing: -0.045em;
    text-transform: uppercase;
    color: var(--color-fg-100);
  }
  .hero h1 span:last-child { color: var(--color-accent); }
  .hero__lead {
    margin-top: 26px;
    max-width: 44ch;
    font-size: clamp(16px, 1.4vw, 19px);
    color: var(--color-fg-300);
  }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 34px; }

  .hero__cue {
    position: absolute;
    z-index: 3;
    left: clamp(20px, 5vw, 88px);
    bottom: 34px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-fg-500);
  }
  .hero__cue :global(svg) { animation: bob 2.6s var(--ease-out-expo) infinite; }
  @keyframes bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(6px); }
  }

  /* ================= MANIFEST ================= */
  .manifest {
    justify-content: center;
    gap: clamp(48px, 8vh, 96px);
    padding: clamp(88px, 12vh, 140px) clamp(20px, 5vw, 88px);
    min-height: auto;
  }
  .manifest__lede {
    display: grid;
    gap: clamp(20px, 2.6vw, 32px);
    max-width: 62ch;
  }
  .manifest__text {
    display: grid;
    gap: 0.14em;
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(25px, 3.6vw, 50px);
    line-height: 1.2;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  /* Birinchi qator xiraroq, xulosa yorqin — o'qish osonlashadi. */
  .manifest__text span { color: var(--color-fg-300); }
  .manifest__text b { font-weight: 700; color: var(--color-fg-100); }
  .manifest__sub {
    max-width: 52ch;
    font-size: clamp(16px, 1.3vw, 19px);
    line-height: 1.65;
    color: var(--color-fg-300);
  }
  .manifest__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    border-top: 1px solid var(--line);
  }
  .manifest__grid li {
    padding: 28px 24px 0 0;
    border-right: 1px solid var(--line-2);
  }
  .manifest__grid li:last-child { border-right: 0; }
  .manifest__grid li:not(:first-child) { padding-left: 24px; }
  .manifest__grid span {
    font-family: var(--display);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--color-accent);
  }
  .manifest__grid h3 {
    margin-top: 16px;
    font-size: 19px;
    font-weight: 700;
    color: var(--color-fg-100);
  }
  .manifest__grid p { margin-top: 10px; font-size: 15px; color: var(--color-fg-300); }

  /* ================= STATISTIKA ================= */
  .stats {
    background: var(--color-accent);
    justify-content: center;
    padding: clamp(72px, 12vh, 128px) clamp(20px, 5vw, 88px);
    min-height: auto;
  }
  .stats ul { display: grid; gap: 0; }
  .stats li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: clamp(16px, 2.4vw, 28px) 0;
    border-bottom: 1px solid rgb(255 255 255 / 0.24);
  }
  .stats li:last-child { border-bottom: 0; }
  .stats__v {
    font-family: var(--display);
    font-size: clamp(40px, 8vw, 108px);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.05em;
    color: #fff;
  }
  .stats__l {
    font-size: clamp(12px, 1.2vw, 15px);
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.85);
  }

  /* ================= GALEREYA ================= */
  .shots { display: grid; }
  .shot { position: relative; height: min(78svh, 640px); overflow: clip; }
  .shot__img { position: absolute; inset: -8% 0; }
  .shot__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(1.08) saturate(0.62) brightness(0.72);
    transition: transform 0.2s linear;
  }
  .shot figcaption {
    position: absolute;
    z-index: 2;
    left: clamp(20px, 5vw, 88px);
    bottom: 32px;
    display: flex;
    align-items: baseline;
    gap: 16px;
    font-family: var(--display);
    font-size: clamp(18px, 2.6vw, 34px);
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--color-fg-100);
    text-shadow: 0 2px 24px rgb(0 0 0 / 0.6);
  }
  .shot figcaption span { font-size: 13px; color: var(--color-accent-hot); }

  /* ================= BRENDLAR ================= */
  .brands { padding: clamp(64px, 10vh, 112px) 0; }
  .brands__head { padding: 0 clamp(20px, 5vw, 88px) 40px; }
  .brands__head h2 {
    font-family: var(--display);
    font-size: clamp(28px, 4vw, 54px);
    font-weight: 700;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    color: var(--color-fg-100);
  }
  .brands__head p { margin-top: 12px; font-size: 15px; color: var(--color-fg-500); }
  .marquee {
    overflow: hidden;
    padding-block: 20px;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .marquee__track {
    display: flex;
    gap: 64px;
    width: max-content;
    animation: slide 40s linear infinite;
  }
  .marquee[data-dir='1'] .marquee__track { animation-direction: reverse; animation-duration: 52s; }
  .marquee:hover .marquee__track { animation-play-state: paused; }
  .marquee span { flex: none; display: grid; place-items: center; }
  .marquee img {
    max-height: 44px;
    width: auto;
    opacity: 0.45;
    transition: opacity 0.25s var(--ease-out-expo);
  }
  .marquee span:hover img { opacity: 1; }
  @keyframes slide {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* ================= ULGURJI ================= */
  .split { display: grid; grid-template-columns: 1fr 1fr; align-items: stretch; }
  .split__left {
    background: var(--color-accent);
    padding: clamp(48px, 7vw, 96px) clamp(24px, 4vw, 72px);
    display: grid;
    align-content: center;
  }
  .split__left h2 {
    margin-top: 18px;
    font-family: var(--display);
    font-size: clamp(38px, 5.4vw, 82px);
    font-weight: 700;
    line-height: 0.94;
    letter-spacing: -0.05em;
    text-transform: uppercase;
    color: #fff;
  }
  .split__lead { margin-top: 20px; max-width: 40ch; color: rgb(255 255 255 / 0.9); }
  .split__services { margin-top: 28px; display: grid; gap: 10px; }
  .split__services li {
    padding-top: 10px;
    border-top: 1px solid rgb(255 255 255 / 0.28);
    font-size: 15px;
    color: rgb(255 255 255 / 0.9);
  }
  .split__services b { color: #fff; font-weight: 700; }

  .split__contact {
    padding: clamp(40px, 6vw, 88px) clamp(24px, 4vw, 72px);
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 0;
    background: var(--color-bg-800);
  }
  .split__contact h3 {
    font-family: var(--display);
    font-size: clamp(24px, 2.8vw, 36px);
