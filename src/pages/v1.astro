---
import '@fontsource-variable/oswald';
import '@fontsource-variable/inter';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import OpenStatus from '../components/OpenStatus.astro';
import { site, stats, categories, advantages, services, brands, faq } from '../data/site.js';

import street from '../../images/street.jpg';
import logoWhite from '../../images/logoWhite.png';
import heroObject from '../../images/hero/object.png';

const photoMods = import.meta.glob<ImageMetadata>('../../images/photo*.jpg', {
  eager: true,
  import: 'default',
});
const photos = Object.keys(photoMods)
  .sort((a, b) => a.localeCompare(b, 'en', { numeric: true }))
  .map((k) => photoMods[k]);

const brandMods = import.meta.glob<ImageMetadata>('../../images/brands-mono/*.png', {
  eager: true,
  import: 'default',
});
const brandLogos = brands.map((b) => ({
  ...b,
  img: brandMods[`../../images/brands-mono/${b.file.replace(/\.\w+$/, '.png')}`],
}));

const slides = [street, ...photos.slice(0, 6)];
const nav = [
  { href: '#toifalar', label: 'Toifalar' },
  { href: '#nega-biz', label: 'Nega biz' },
  { href: '#dokon', label: "Do'kon" },
  { href: '#ulgurji', label: 'Ulgurji' },
  { href: '#manzil', label: 'Manzil' },
];
const mapSrc = `https://www.openstreetmap.org/export/embed.html?bbox=${site.coords.lng - 0.006}%2C${site.coords.lat - 0.003}%2C${site.coords.lng + 0.006}%2C${site.coords.lat + 0.003}&layer=mapnik`;
---

<Base
  variant="v1"
  title="Diyor Stroy — Samarqandda qurilish mollari, 5000+ mahsulot"
  description="Xalil Sulton 150, Samarqand. Sement, gipsokarton, bo'yoq, santexnika, kafel. Har kuni 07:00–20:00. Tel: +998 97 646 10 00."
>
  <a class="skip" href="#toifalar">Kontentga o'tish</a>

  <!-- ============ HERO ============ -->
  <header class="hero">
    <div class="hero__media">
      {
        slides.map((img, i) => (
          <figure class="slide" data-slide data-active={i === 0 ? 'true' : undefined}>
            <Image
              src={img}
              alt=""
              widths={[720, 1280, 1920]}
              sizes="100vw"
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : undefined}
            />
          </figure>
        ))
      }
      <div class="hero__scrim"></div>
    </div>

    <nav class="topbar" aria-label="Asosiy">
      <a class="brand" href="/v1">
        <Image src={logoWhite} alt="Diyor Stroy" widths={[140, 280]} sizes="140px" />
      </a>
      <ul class="pills">
        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      </ul>
      <a class="topbar__call" href={site.phoneHref}>
        <Icon name="phone" size={17} />
        <span class="tnum">{site.phone}</span>
      </a>
    </nav>

    <div class="hero__inner">
      <div class="hero__text">
        <p class="eyebrow"><span></span>Samarqand · Xalil Sulton 150</p>
        <h1>
          <span class="l1">Qurilish</span>
          <span class="l2">mollari</span>
        </h1>
        <p class="hero__lead">
          To'g'ridan-to'g'ri ishlab chiqaruvchi va yirik distribyutorlardan.
          Oraliq ustama yo'q — narx bozor narxidan past, tovar sertifikatlangan.
        </p>
        <div class="hero__cta">
          <a class="btn" href={site.phoneHref}>
            Qo'ng'iroq qilish <Icon name="arrow" size={18} />
          </a>
          <a class="btn btn--ghost" href={site.telegram} target="_blank" rel="noopener">
            <Icon name="telegram" size={18} /> Telegram
          </a>
        </div>
      </div>

      <div class="hero__object">
        <span class="hero__plate" aria-hidden="true"></span>
        <Image src={heroObject} alt="" widths={[420, 760, 1100]} sizes="(max-width: 900px) 60vw, 40vw" />
      </div>

      <aside class="infocard">
        <OpenStatus />
        <dl>
          <div><dt>Ish vaqti</dt><dd class="tnum">{site.hours}</dd></div>
          <div><dt>Manzil</dt><dd>{site.addressShort}</dd></div>
          <div><dt>Assortiment</dt><dd>5000+ mahsulot turi</dd></div>
        </dl>
        <a class="infocard__link" href="#manzil">Yo'lni ko'rsatish <Icon name="arrow" size={15} /></a>
      </aside>
    </div>

    <div class="hero__foot">
      <div class="hero__footleft">
        <div class="counter">
          <button type="button" data-prev aria-label="Oldingi rasm"><Icon name="arrow" size={16} /></button>
          <span class="tnum"><b data-current>01</b> / {String(slides.length).padStart(2, '0')}</span>
          <button type="button" data-next aria-label="Keyingi rasm"><Icon name="arrow" size={16} /></button>
        </div>
        <a class="scrollcue" href="#toifalar">
          <span>Pastga</span><Icon name="arrow-down" size={16} />
        </a>
      </div>
      <ul class="socials">
        <li><a href={site.telegram} target="_blank" rel="noopener" aria-label="Telegram"><Icon name="telegram" size={18} /></a></li>
        <li><a href={site.instagram} target="_blank" rel="noopener" aria-label="Instagram"><Icon name="instagram" size={18} /></a></li>
      </ul>
    </div>
  </header>

  <!-- ============ TOIFALAR ============ -->
  <section class="section" id="toifalar">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow"><span></span>Toifalar</p>
        <h2>Butun ta'mir uchun<br />kerakli hamma narsa</h2>
        <p class="head__note">
          5000+ mahsulot turi bitta joyda. Narx telefon orqali aytiladi —
          kerakli toifani ayting, mavjudligini darrov tekshiramiz.
        </p>
      </div>

      <ul class="cats">
        {
          categories.map((c, i) => (
            <li class="cat" data-reveal style={`--reveal-delay:${(i % 3) * 80}ms`}>
              <span class="cat__n tnum">{String(i + 1).padStart(2, '0')}</span>
              <h3>{c.title}</h3>
              <p>{c.items}</p>
              <a class="cat__ask" href={site.phoneHref}>Narxni so'rash <Icon name="arrow" size={15} /></a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============ NEGA BIZ ============ -->
  <section class="section section--tight" id="nega-biz">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow"><span></span>Nega Diyor Stroy</p>
        <h2>Arzon va sifatli —<br />bitta manba tufayli</h2>
      </div>
      <ul class="adv">
        {
          advantages.map((a, i) => (
            <li data-reveal style={`--reveal-delay:${i * 80}ms`}>
              <Icon name={['tag', 'shield', 'truck', 'sunrise'][i]} size={26} />
              <h3>{a.title}</h3>
              <p>{a.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============ STATISTIKA ============ -->
  <section class="stats" aria-label="Raqamlar">
    <ul>
      {
        stats.map((s) => (
          <li>
            <span class="stats__v tnum">{s.value}</span>
            <span class="stats__l">{s.label}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ============ BRENDLAR ============ -->
  <section class="section section--tight" id="brendlar">
    <div class="wrap">
      <div class="head head--row">
        <div>
          <p class="eyebrow"><span></span>Brendlar</p>
          <h2>Rasmiy mahsulotlar</h2>
        </div>
        <p class="head__note">
          Faqat sertifikatlangan, sifat nazoratidan o'tgan tovar. Soxta yoki
          past sifatli mahsulot sotilmaydi.
        </p>
      </div>
      <ul class="brands">
        {
          brandLogos.map((b) => (
            <li>
              <Image src={b.img} alt={b.name} widths={[120, 240]} sizes="120px" loading="lazy" />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============ DO'KON ============ -->
  <section class="gallery" id="dokon">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow"><span></span>Do'kon</p>
        <h2>Rastalar, ombor,<br />mahsulotlar</h2>
      </div>
    </div>
    <ul class="strip">
      {
        photos.map((p, i) => (
          <li class={i % 3 === 0 ? 'is-wide' : ''}>
            <Image src={p} alt="Diyor Stroy do'koni" widths={[480, 900]} sizes="(max-width: 720px) 78vw, 34vw" loading="lazy" />
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ============ ULGURJI ============ -->
  <section class="section" id="ulgurji">
    <div class="wrap wholesale">
      <div class="wholesale__copy">
        <p class="eyebrow"><span></span>Ulgurji va brigadalar</p>
        <h2>Katta hajm —<br />alohida narx</h2>
        <p>
          Pudratchi, usta va brigadalar bilan doimiy ishlaymiz. Hajmni ayting —
          chegirma narxni hisoblab beramiz va yetkazib berishni kelishamiz.
        </p>
        <ul class="wholesale__list">
          {
            services.map((s) => (
              <li>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </li>
            ))
          }
        </ul>
        <p class="wholesale__early">
          <Icon name="sunrise" size={22} />
          <span>Do'kon <b>07:00</b> da ochiladi — brigada ish boshlashidan oldin material olib ulguradi.</span>
        </p>
      </div>

      <form class="form" name="ulgurji" method="POST" data-netlify="true" netlify-honeypot="bot-field">
        <input type="hidden" name="form-name" value="ulgurji" />
        <p class="hp"><label>Bo'sh qoldiring <input name="bot-field" /></label></p>
        <h3>Ulgurji so'rov</h3>
        <label>
          <span>Ismingiz</span>
          <input type="text" name="ism" required autocomplete="name" placeholder="Ism" />
        </label>
        <label>
          <span>Telefon</span>
          <input type="tel" name="telefon" required autocomplete="tel" placeholder="+998 __ ___ __ __" />
        </label>
        <label>
          <span>Nima kerak</span>
          <textarea name="sorov" rows="3" required placeholder="Masalan: 200 qop sement, 40 list gipsokarton"></textarea>
        </label>
        <button class="btn" type="submit">Yuborish <Icon name="arrow" size={18} /></button>
        <p class="form__note">Yoki to'g'ridan-to'g'ri: <a href={site.phoneHref} class="tnum">{site.phone}</a></p>
      </form>
    </div>
  </section>

  <!-- ============ MANZIL ============ -->
  <section class="section section--tight" id="manzil">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow"><span></span>Qayerdamiz</p>
        <h2>Xalil Sulton 150,<br />Oqmachit MFY</h2>
      </div>
      <div class="mapgrid">
        <div class="mapgrid__map">
          <iframe
            src={mapSrc}
            title="Diyor Stroy xaritada"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"></iframe>
          <span class="mapgrid__pin" aria-hidden="true"></span>
        </div>
        <ul class="mapgrid__info">
          <li>
            <Icon name="pin" size={20} />
            <div><h3>Manzil</h3><p>{site.address}</p></div>
          </li>
          <li>
            <Icon name="clock" size={20} />
            <div><h3>Ish vaqti</h3><p class="tnum">{site.hours} · {site.hoursNote}</p></div>
          </li>
          <li>
            <Icon name="phone" size={20} />
            <div><h3>Telefon va Telegram</h3><p><a href={site.phoneHref} class="tnum">{site.phone}</a></p></div>
          </li>
          <li>
            <Icon name="tag" size={20} />
            <div><h3>To'lov</h3><p>{site.payments.join(' · ')}</p></div>
          </li>
          <li class="mapgrid__links">
            <a class="btn btn--ghost" href={site.googleMaps} target="_blank" rel="noopener">
              <Icon name="route" size={17} /> Google Maps
            </a>
            <a class="btn btn--ghost" href={site.yandexMaps} target="_blank" rel="noopener">
              <Icon name="route" size={17} /> Yandex
            </a>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="section section--tight" id="savollar">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow"><span></span>Savollar</p>
        <h2>Ko'p so'raladi</h2>
      </div>
      <ul class="faq">
        {
          faq.map((f) => (
            <li>
              <details>
                <summary>
                  <span>{f.q}</span>
                  <i aria-hidden="true"></i>
                </summary>
                <p>{f.a}</p>
              </details>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="cta">
    <div class="cta__left">
      <h2>Narxni telefonda aytamiz</h2>
      <p>Kerakli mahsulotni ayting — mavjudligini va aniq narxni bir daqiqada bilasiz.</p>
    </div>
    <div class="cta__right">
      <a class="cta__big" href={site.phoneHref}>
        <span class="tnum">{site.phone}</span>
        <Icon name="arrow" size={28} />
      </a>
      <div class="cta__row">
        <a class="btn btn--ghost" href={site.telegram} target="_blank" rel="noopener"><Icon name="telegram" size={18} /> Telegram</a>
        <a class="btn btn--ghost" href={site.instagram} target="_blank" rel="noopener"><Icon name="instagram" size={18} /> Instagram</a>
      </div>
    </div>
  </section>

  <!-- ============ FOOTER ============ -->
  <footer class="footer">
    <div class="wrap footer__grid">
      <div>
        <Image src={logoWhite} alt="Diyor Stroy" widths={[130, 260]} sizes="130px" />
        <p>Samarqanddagi qurilish mollari va ta'mirlash materiallari do'koni. 6 yildan ortiq tajriba.</p>
      </div>
      <div>
        <h3>Bo'limlar</h3>
        <ul>{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
      </div>
      <div>
        <h3>Aloqa</h3>
        <ul>
          <li><a href={site.phoneHref} class="tnum">{site.phone}</a></li>
          <li><a href={site.telegram} target="_blank" rel="noopener">Telegram</a></li>
          <li><a href={site.instagram} target="_blank" rel="noopener">{site.instagramHandle}</a></li>
        </ul>
      </div>
      <div>
        <h3>Manzil</h3>
        <ul>
          <li>{site.address}</li>
          <li class="tnum">{site.hours}, har kuni</li>
        </ul>
      </div>
    </div>
    <div class="wrap footer__bottom">
      <span>© {new Date().getFullYear()} Diyor Stroy</span>
      <span>Samarqand, O'zbekiston</span>
    </div>
  </footer>

  <!-- ============ MOBIL ALOQA PANELI ============ -->
  <div class="mobilebar">
    <a href={site.phoneHref}><Icon name="phone" size={19} /> Qo'ng'iroq</a>
    <a href={site.telegram} target="_blank" rel="noopener"><Icon name="telegram" size={19} /> Telegram</a>
  </div>

  <script>
    // Hero slayder: 01 / 07 hisoblagichi haqiqiy slaydlarni sanaydi.
    const slides = Array.from(document.querySelectorAll('[data-slide]'));
    const current = document.querySelector('[data-current]');
    if (slides.length > 1 && current) {
      let i = 0;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const show = (next: number) => {
        i = (next + slides.length) % slides.length;
        slides.forEach((s, n) => s.toggleAttribute('data-active', n === i));
        current.textContent = String(i + 1).padStart(2, '0');
      };
      document.querySelector('[data-next]')?.addEventListener('click', () => show(i + 1));
      document.querySelector('[data-prev]')?.addEventListener('click', () => show(i - 1));
      if (!reduce) {
        let timer = window.setInterval(() => show(i + 1), 6000);
        document.addEventListener('visibilitychange', () => {
          if (document.hidden) window.clearInterval(timer);
          else timer = window.setInterval(() => show(i + 1), 6000);
        });
      }
    }
  </script>
</Base>

<style is:global>
  body.variant-v1 {
    --display: 'Oswald Variable', 'Inter Variable', sans-serif;
  }
</style>

<style>
  /* ================= umumiy ================= */
  .skip {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 200;
    padding: 12px 18px;
    background: var(--color-accent);
    color: #fff;
  }
  .skip:focus {
    left: 12px;
    top: 12px;
  }

  .wrap {
    max-width: 1440px;
    margin: 0 auto;
    padding-inline: var(--page-x);
  }

  .section {
    padding-block: clamp(72px, 10vw, 128px);
  }
  .section--tight {
    padding-block: clamp(56px, 8vw, 104px);
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-fg-500);
    margin-bottom: 20px;
  }
  .eyebrow span {
    width: 32px;
    height: 2px;
    background: var(--color-accent);
    flex: none;
  }

  h1, h2, h3 {
    color: var(--color-fg-100);
    font-weight: 500;
  }

  .head {
    max-width: 1100px;
    margin-bottom: clamp(40px, 5vw, 72px);
  }
  .head h2 {
    font-family: var(--display);
    font-size: clamp(38px, 6.2vw, 72px);
    line-height: 1.02;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .head__note {
    margin-top: 20px;
    max-width: 56ch;
    color: var(--color-fg-300);
  }
  .head--row {
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
    align-items: flex-end;
    justify-content: space-between;
    max-width: none;
  }
  .head--row .head__note {
    margin-top: 0;
    max-width: 42ch;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 28px;
    min-height: 52px;
    background: var(--color-accent);
    color: #fff;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border-radius: 0;
    transition: background 0.2s var(--ease-out-expo);
  }
  .btn :global(svg) {
    transition: transform 0.2s var(--ease-out-expo);
  }
  .btn:hover {
    background: var(--color-accent-hot);
  }
  .btn:hover :global(svg) {
    transform: translateX(4px);
  }
  .btn--ghost {
    background: transparent;
    color: var(--color-fg-100);
    border: 1px solid var(--line);
  }
  .btn--ghost:hover {
    background: transparent;
    border-color: var(--color-fg-100);
  }

  /* ================= HERO ================= */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    overflow: clip;
  }
  .hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.1s var(--ease-out-expo);
  }
  .slide[data-active] {
    opacity: 1;
  }
  .slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(1.1) saturate(0.6) brightness(0.62);
    transform: scale(1.04);
  }
  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(100deg, rgb(10 10 11 / 0.94) 8%, rgb(10 10 11 / 0.55) 48%, rgb(10 10 11 / 0.72) 100%),
      linear-gradient(to top, var(--color-bg-900) 2%, transparent 32%),
      radial-gradient(120% 80% at 78% 40%, rgb(228 87 46 / 0.16), transparent 60%);
  }

  .topbar {
    position: relative;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 22px var(--page-x);
    max-width: 1440px;
    margin: 0 auto;
    width: 100%;
  }
  .brand img {
    width: auto;
    height: 62px;
  }
  .pills {
    display: flex;
    gap: 8px;
    margin-inline: auto;
  }
  .pills a {
    display: block;
    padding: 11px 20px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-fg-300);
    transition:
      background 0.2s var(--ease-out-expo),
      color 0.2s var(--ease-out-expo),
      border-color 0.2s var(--ease-out-expo);
  }
  .pills a:hover {
    background: var(--color-fg-100);
    border-color: var(--color-fg-100);
    color: var(--color-bg-900);
  }
  .topbar__call {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--color-fg-100);
    font-size: 15px;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
  .topbar__call :global(svg) {
    color: var(--color-accent);
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    flex: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.78fr);
    grid-template-rows: auto auto;
    align-items: center;
    align-content: center;
    column-gap: 32px;
    row-gap: clamp(16px, 2.4vh, 28px);
    max-width: 1440px;
    width: 100%;
    margin: 0 auto;
    padding: clamp(12px, 2vh, 28px) var(--page-x);
  }
  .hero__text {
    position: relative;
    z-index: 2;
    grid-column: 1;
    grid-row: 1;
    max-width: 640px;
  }
  .hero h1 {
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(52px, 9vw, 118px);
    line-height: 0.86;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--color-fg-100);
    display: flex;
