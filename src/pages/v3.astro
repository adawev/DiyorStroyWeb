---
import '@fontsource-variable/unbounded';
import '@fontsource-variable/manrope';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import OpenStatus from '../components/OpenStatus.astro';
import { site, stats, categories, advantages, services, brands, faq } from '../data/site.js';

import street from '../../images/street.jpg';
import logoWhite from '../../images/logoWhite.png';
import heroObject from '../../images/hero/object.png';

const photoMods = import.meta.glob<ImageMetadata>('../../images/photo*.jpg', {
  eager: true,
  import: 'default',
});
const photos = Object.keys(photoMods)
  .sort((a, b) => a.localeCompare(b, 'en', { numeric: true }))
  .map((k) => photoMods[k]);

const brandMods = import.meta.glob<ImageMetadata>('../../images/brands-mono/*.png', {
  eager: true,
  import: 'default',
});
const brandLogos = brands.map((b) => ({ ...b, img: brandMods[`../../images/brands-mono/${b.file.replace(/\.\w+$/, '.png')}`] }));
const catCards = categories.map((c, i) => ({ ...c, img: photos[i % photos.length] }));
const galleryPanels = photos.slice(0, 4);
const mapSrc = `https://www.openstreetmap.org/export/embed.html?bbox=${site.coords.lng - 0.01}%2C${site.coords.lat - 0.005}%2C${site.coords.lng + 0.01}%2C${site.coords.lat + 0.005}&layer=mapnik`;
---

<Base
  variant="v3"
  title="Diyor Stroy — Samarqandda qurilish mollari do'koni"
  description="6 yil, 30 000+ mijoz, 5000+ mahsulot turi. Xalil Sulton 150, Samarqand. Har kuni 07:00–20:00. +998 97 646 10 00."
>
  <a class="skip" href="#toifalar">Kontentga o'tish</a>

  <div class="topbar">
    <a class="topbar__brand" href="/v3">
      <Image src={logoWhite} alt="Diyor Stroy" widths={[130, 260]} sizes="130px" />
    </a>
    <span class="topbar__status"><OpenStatus /></span>
    <a class="topbar__call" href={site.phoneHref}>
      <Icon name="phone" size={17} />
      <span class="tnum">{site.phone}</span>
    </a>
  </div>

  <!-- ============ HERO ============ -->
  <header class="hero panel">
    <div class="hero__bg" data-parallax>
      <Image src={street} alt="" widths={[720, 1280, 1920]} sizes="100vw" loading="eager" fetchpriority="high" />
    </div>
    <div class="hero__scrim"></div>

    <div class="hero__body">
      <p class="tagline">Samarqand · Xalil Sulton 150 · 07:00 dan</p>
      <h1>
        <span>Qurilish</span>
        <span>mollari</span>
      </h1>
      <p class="hero__lead">
        5000+ mahsulot turi. To'g'ridan-to'g'ri ishlab chiqaruvchidan —
        oraliq ustama yo'q, tovar sertifikatlangan.
      </p>
      <div class="hero__cta">
        <a class="btn" href={site.phoneHref}>Qo'ng'iroq qilish <Icon name="arrow" size={18} /></a>
        <a class="btn btn--ghost" href={site.telegram} target="_blank" rel="noopener">
          <Icon name="telegram" size={18} /> Telegram
        </a>
      </div>
    </div>

    <div class="hero__object">
      <Image src={heroObject} alt="" widths={[420, 760, 1100]} sizes="(max-width: 900px) 70vw, 42vw" />
    </div>

    <a class="hero__cue" href="#manifest"><span>Pastga</span><Icon name="arrow-down" size={18} /></a>
  </header>

  <!-- ============ MANIFEST ============ -->
  <section class="manifest panel" id="manifest">
    <p class="manifest__text" data-reveal>
      Arzon va sifatli odatda bir joyda uchramaydi.
      <b>Bizda uchraydi</b> — chunki mahsulot ishlab chiqaruvchi va yirik
      distribyutorlardan to'g'ridan-to'g'ri olinadi, oraliq ustama yo'q.
    </p>
    <ol class="manifest__grid">
      {
        advantages.map((a, i) => (
          <li data-reveal style={`--reveal-delay:${i * 90}ms`}>
            <span class="tnum">{String(i + 1).padStart(2, '0')}</span>
            <h3>{a.title}</h3>
            <p>{a.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- ============ TOIFALAR ============ -->
  <section class="rail" id="toifalar">
    <div class="rail__head">
      <h2>Toifalar</h2>
      <p>O'ngga suring. Kerakli toifani ayting — narxni telefonda aytamiz.</p>
    </div>
    <ul class="rail__track" data-drag>
      {
        catCards.map((c, i) => (
          <li>
            <a href={site.phoneHref}>
              <Image src={c.img} alt="" widths={[400, 800]} sizes="320px" loading="lazy" />
              <span class="rail__n tnum">{String(i + 1).padStart(2, '0')}</span>
              <div class="rail__meta">
                <h3>{c.title}</h3>
                <p>{c.items}</p>
                <span class="rail__go">Narxni so'rash <Icon name="arrow" size={15} /></span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ============ STATISTIKA ============ -->
  <section class="stats panel" aria-label="Raqamlar">
    <ul>
      {
        stats.map((s) => (
          <li data-reveal>
            <span class="stats__v tnum">{s.value}</span>
            <span class="stats__l">{s.label}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ============ GALEREYA ============ -->
  <section class="shots" id="dokon">
    {
      galleryPanels.map((p, i) => (
        <figure class="shot">
          <div class="shot__img" data-parallax>
            <Image src={p} alt="Diyor Stroy do'koni" widths={[720, 1400]} sizes="100vw" loading="lazy" />
          </div>
          <figcaption>
            <span class="tnum">{String(i + 1).padStart(2, '0')}</span>
            {['Rastalar va ombor', 'Santexnika bo\'limi', 'Quruq qorishmalar', 'Asbob-uskuna'][i]}
          </figcaption>
        </figure>
      ))
    }
  </section>

  <!-- ============ BRENDLAR ============ -->
  <section class="brands" id="brendlar">
    <div class="brands__head">
      <h2>Rasmiy brendlar</h2>
      <p>Faqat sertifikatlangan, sifat nazoratidan o'tgan mahsulot.</p>
    </div>
    {
      [0, 1].map((row) => (
        <div class="marquee" data-dir={row}>
          <div class="marquee__track">
            {[0, 1].map(() =>
              (row === 0 ? brandLogos.slice(0, 8) : brandLogos.slice(8)).map((b) => (
                <span><Image src={b.img} alt={b.name} widths={[120, 240]} sizes="120px" loading="lazy" /></span>
              )),
            )}
          </div>
        </div>
      ))
    }
  </section>

  <!-- ============ ULGURJI ============ -->
  <section class="split" id="ulgurji">
    <div class="split__left">
      <p class="tagline tagline--dark">Ulgurji va brigadalar</p>
      <h2>07:00 da<br />ochamiz</h2>
      <p class="split__lead">
        Brigada ish boshlashidan oldin material olib ulgursin. Katta hajmdagi
        buyurtmalarga alohida chegirma narx.
      </p>
      <ul class="split__services">
        {services.map((s) => <li><b>{s.title}</b> — {s.text}</li>)}
      </ul>
    </div>

    <form class="split__form" name="ulgurji-v3" method="POST" data-netlify="true" netlify-honeypot="bot-field">
      <input type="hidden" name="form-name" value="ulgurji-v3" />
      <p class="hp"><label>Bo'sh qoldiring <input name="bot-field" /></label></p>
      <h3>Chegirma narx so'rash</h3>
      <label>
        <span>Ismingiz</span>
        <input type="text" name="ism" required autocomplete="name" placeholder="Ism" />
      </label>
      <label>
        <span>Telefon</span>
        <input type="tel" name="telefon" required autocomplete="tel" placeholder="+998 __ ___ __ __" />
      </label>
      <label>
        <span>Nima kerak</span>
        <textarea name="sorov" rows="3" required placeholder="200 qop sement, 40 list gipsokarton…"></textarea>
      </label>
      <button class="btn" type="submit">Yuborish <Icon name="arrow" size={18} /></button>
    </form>
  </section>

  <!-- ============ MANZIL ============ -->
  <section class="map" id="manzil">
    <iframe src={mapSrc} title="Diyor Stroy xaritada" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    <span class="map__pin" aria-hidden="true"></span>
    <div class="map__card">
      <h2>Qayerdamiz</h2>
      <ul>
        <li><Icon name="pin" size={18} /><span>{site.address}</span></li>
        <li><Icon name="clock" size={18} /><span class="tnum">{site.hours} · {site.hoursNote}</span></li>
        <li><Icon name="phone" size={18} /><a href={site.phoneHref} class="tnum">{site.phone}</a></li>
        <li><Icon name="tag" size={18} /><span>{site.payments.join(' · ')}</span></li>
      </ul>
      <div class="map__links">
        <a class="btn btn--ghost" href={site.googleMaps} target="_blank" rel="noopener"><Icon name="route" size={16} /> Google</a>
        <a class="btn btn--ghost" href={site.yandexMaps} target="_blank" rel="noopener"><Icon name="route" size={16} /> Yandex</a>
      </div>
    </div>
  </section>

  <!-- ============ SAVOLLAR ============ -->
  <section class="faq" id="savollar">
    <h2>Savollar</h2>
    <ul>
      {
        faq.map((f) => (
          <li>
            <details>
              <summary><span>{f.q}</span><i aria-hidden="true"></i></summary>
              <p>{f.a}</p>
            </details>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ============ CTA + FOOTER ============ -->
  <section class="cta">
    <h2>Narxni telefonda<br />aytamiz</h2>
    <a class="cta__phone tnum" href={site.phoneHref}>{site.phone} <Icon name="arrow" size={30} /></a>
    <div class="cta__row">
      <a class="btn btn--ghost" href={site.telegram} target="_blank" rel="noopener"><Icon name="telegram" size={18} /> Telegram</a>
      <a class="btn btn--ghost" href={site.instagram} target="_blank" rel="noopener"><Icon name="instagram" size={18} /> Instagram</a>
    </div>
  </section>

  <footer class="footer">
    <p class="footer__word">Diyor Stroy</p>
    <div class="footer__row">
      <span>{site.address}</span>
      <span class="tnum">{site.hours} · har kuni</span>
      <span>© {new Date().getFullYear()}</span>
    </div>
  </footer>

  <div class="mobilebar">
    <a href={site.phoneHref}><Icon name="phone" size={19} /> Qo'ng'iroq</a>
    <a href={site.telegram} target="_blank" rel="noopener"><Icon name="telegram" size={19} /> Telegram</a>
  </div>

  <script>
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Yengil parallaks — faqat harakat ruxsat etilganda.
    if (!reduce) {
      const layers = Array.from(document.querySelectorAll<HTMLElement>('[data-parallax]'));
      let ticking = false;
      const update = () => {
        layers.forEach((el) => {
          const r = el.getBoundingClientRect();
          if (r.bottom < -200 || r.top > window.innerHeight + 200) return;
          const progress = (r.top + r.height / 2 - window.innerHeight / 2) / window.innerHeight;
          el.style.setProperty('--shift', `${(progress * -8).toFixed(2)}%`);
        });
        ticking = false;
      };
      addEventListener(
        'scroll',
        () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(update);
          }
        },
        { passive: true },
      );
      update();
    }

    // Raqamlar ko'rinishga kirganda sanaladi.
    const nums = Array.from(document.querySelectorAll<HTMLElement>('.stats__v'));
    if (nums.length && !reduce) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            const el = e.target as HTMLElement;
            io.unobserve(el);
            const raw = el.textContent || '';
            const digits = raw.replace(/[^\d]/g, '');
            if (!digits || raw.includes(':')) return;
            const target = parseInt(digits, 10);
            const suffix = raw.trim().endsWith('+') ? '+' : '';
            const t0 = performance.now();
            const step = (t: number) => {
              const p = Math.min(1, (t - t0) / 1100);
              const eased = 1 - Math.pow(1 - p, 3);
              const value = Math.round(target * eased);
              el.textContent = value.toLocaleString('ru-RU').replace(/ /g, ' ') + suffix;
              if (p < 1) requestAnimationFrame(step);
            };
            requestAnimationFrame(step);
          });
        },
        { threshold: 0.4 },
      );
      nums.forEach((n) => io.observe(n));
    }

    // Toifalar relsi: sichqoncha bilan tortib surish.
    const track = document.querySelector<HTMLElement>('[data-drag]');
    if (track) {
      let down = false;
      let startX = 0;
      let startLeft = 0;
      track.addEventListener('pointerdown', (e) => {
        if (e.pointerType === 'touch') return;
        down = true;
        startX = e.clientX;
        startLeft = track.scrollLeft;
        track.classList.add('is-drag');
      });
      addEventListener('pointerup', () => {
        down = false;
        track.classList.remove('is-drag');
      });
      track.addEventListener('pointermove', (e) => {
        if (!down) return;
        e.preventDefault();
        track.scrollLeft = startLeft - (e.clientX - startX);
      });
    }
  </script>
</Base>

<style is:global>
  body.variant-v3 {
    --display: 'Unbounded Variable', 'Manrope Variable', sans-serif;
    font-family: 'Manrope Variable', ui-sans-serif, system-ui, sans-serif;
  }
</style>

<style>
  .skip {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 200;
    padding: 12px 18px;
    background: var(--color-accent);
    color: #fff;
  }
  .skip:focus { left: 12px; top: 12px; }

  .tagline {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-fg-500);
  }
  .tagline--dark { color: rgb(255 255 255 / 0.72); }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 54px;
    padding: 15px 26px;
    background: var(--color-accent);
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border-radius: 999px;
    transition: background 0.25s var(--ease-out-expo), transform 0.25s var(--ease-out-expo);
  }
  .btn :global(svg) { transition: transform 0.25s var(--ease-out-expo); }
  .btn:hover { background: var(--color-accent-hot); }
  .btn:hover :global(svg) { transform: translateX(4px); }
  .btn--ghost {
    background: transparent;
    color: var(--color-fg-100);
    border: 1px solid var(--line);
  }
  .btn--ghost:hover { background: rgb(255 255 255 / 0.06); border-color: var(--color-fg-100); }

  /* ================= TOPBAR ================= */
  .topbar {
    position: fixed;
    z-index: 60;
    inset: 0 0 auto 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 18px clamp(20px, 4vw, 48px);
    background: linear-gradient(to bottom, rgb(10 10 11 / 0.85), transparent);
  }
  .topbar__brand img { width: auto; height: 54px; }
  .topbar__status { display: block; margin-inline: auto; }
  .topbar__call {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 11px 20px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgb(10 10 11 / 0.5);
    backdrop-filter: blur(12px);
    color: var(--color-fg-100);
    font-size: 14px;
    white-space: nowrap;
    transition: border-color 0.2s, background 0.2s;
  }
  .topbar__call :global(svg) { color: var(--color-accent); }
  .topbar__call:hover { border-color: var(--color-accent); background: rgb(228 87 46 / 0.12); }

  section[id],
  header[id] {
    scroll-margin-top: 88px;
  }

  .panel {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
  }

  /* ================= HERO ================= */
  .hero { overflow: clip; padding: 120px clamp(20px, 5vw, 88px) 96px; }
  .hero__bg { position: absolute; inset: -6% 0; z-index: 0; }
  .hero__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: translateY(var(--shift, 0)) scale(1.08);
    filter: contrast(1.12) saturate(0.5) brightness(0.5);
    transition: transform 0.2s linear;
  }
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(85deg, rgb(10 10 11 / 0.95) 12%, rgb(10 10 11 / 0.5) 60%, rgb(10 10 11 / 0.85)),
      linear-gradient(to top, var(--color-bg-900) 1%, transparent 30%);
  }
  .hero__body { position: relative; z-index: 3; max-width: 900px; }
  .hero h1 {
    margin-top: 22px;
    display: flex;
    flex-direction: column;
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(46px, 8.4vw, 124px);
    line-height: 0.94;
    letter-spacing: -0.045em;
    text-transform: uppercase;
    color: var(--color-fg-100);
  }
  .hero h1 span:last-child { color: var(--color-accent); }
  .hero__lead {
    margin-top: 26px;
    max-width: 44ch;
    font-size: clamp(16px, 1.4vw, 19px);
    color: var(--color-fg-300);
  }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 34px; }

  .hero__object {
    position: absolute;
    z-index: 2;
    right: clamp(-40px, -2vw, 0px);
    bottom: 0;
    width: min(46vw, 620px);
    pointer-events: none;
  }
  .hero__object img {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 40px 70px rgb(0 0 0 / 0.7));
  }

  .hero__cue {
    position: absolute;
    z-index: 3;
    left: clamp(20px, 5vw, 88px);
    bottom: 34px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-fg-500);
  }
  .hero__cue :global(svg) { animation: bob 2.6s var(--ease-out-expo) infinite; }
  @keyframes bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(6px); }
  }

  /* ================= MANIFEST ================= */
  .manifest {
    justify-content: center;
    gap: clamp(48px, 8vh, 96px);
    padding: clamp(88px, 12vh, 140px) clamp(20px, 5vw, 88px);
    min-height: auto;
  }
  .manifest__text {
    max-width: 24ch;
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(26px, 4.4vw, 62px);
    line-height: 1.16;
    letter-spacing: -0.035em;
    color: var(--color-fg-500);
  }
  .manifest__text b { font-weight: 700; color: var(--color-fg-100); }
  .manifest__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    border-top: 1px solid var(--line);
  }
  .manifest__grid li {
    padding: 28px 24px 0 0;
    border-right: 1px solid var(--line-2);
  }
  .manifest__grid li:last-child { border-right: 0; }
  .manifest__grid li:not(:first-child) { padding-left: 24px; }
  .manifest__grid span {
    font-family: var(--display);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--color-accent);
  }
  .manifest__grid h3 {
    margin-top: 16px;
    font-size: 19px;
    font-weight: 700;
    color: var(--color-fg-100);
  }
  .manifest__grid p { margin-top: 10px; font-size: 15px; color: var(--color-fg-300); }

  /* ================= TOIFALAR RELSI ================= */
  .rail { padding: clamp(56px, 9vh, 104px) 0; }
  .rail__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 0 clamp(20px, 5vw, 88px) 36px;
  }
  .rail__head h2 {
    font-family: var(--display);
    font-size: clamp(28px, 4vw, 54px);
    font-weight: 700;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    color: var(--color-fg-100);
  }
  .rail__head p { font-size: 15px; color: var(--color-fg-500); }
  .rail__track {
    display: flex;
    gap: 14px;
    overflow-x: auto;
    padding: 4px clamp(20px, 5vw, 88px) 20px;
    scroll-snap-type: x mandatory;
    cursor: grab;
  }
  .rail__track.is-drag { cursor: grabbing; scroll-snap-type: none; }
  .rail__track li { flex: 0 0 auto; width: min(78vw, 320px); scroll-snap-align: start; }
  .rail__track a {
    position: relative;
    display: block;
    height: 420px;
    overflow: hidden;
    border-radius: 20px;
    border: 1px solid var(--line-2);
    background: var(--color-bg-800);
  }
  .rail__track img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(1.1) saturate(0.55) brightness(0.5);
    transition: transform 0.6s var(--ease-out-expo), filter 0.4s var(--ease-out-expo);
  }
  .rail__track a::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(10 10 11 / 0.95) 12%, rgb(10 10 11 / 0.2) 62%);
  }
  .rail__track a:hover img { transform: scale(1.06); filter: contrast(1.05) saturate(0.8) brightness(0.62); }
  .rail__n {
    position: absolute;
    z-index: 2;
    top: 18px;
    left: 20px;
    font-family: var(--display);
    font-size: 13px;
    font-weight: 600;
    color: var(--color-accent-hot);
  }
  .rail__meta {
    position: absolute;
    z-index: 2;
    inset: auto 20px 20px;
  }
  .rail__meta h3 {
    font-size: 21px;
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-fg-100);
  }
  .rail__meta p { margin-top: 8px; font-size: 14px; color: var(--color-fg-300); }
  .rail__go {
