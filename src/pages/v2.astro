---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/inter';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import OpenStatus from '../components/OpenStatus.astro';
import { site, stats, categories, advantages, services, brands, faq } from '../data/site.js';

import street from '../../images/street.jpg';
import logoWhite from '../../images/logoWhite.png';

const photoMods = import.meta.glob<ImageMetadata>('../../images/photo*.jpg', {
  eager: true,
  import: 'default',
});
const photos = Object.keys(photoMods)
  .sort((a, b) => a.localeCompare(b, 'en', { numeric: true }))
  .map((k) => photoMods[k]);

const brandMods = import.meta.glob<ImageMetadata>('../../images/brands-mono/*.png', {
  eager: true,
  import: 'default',
});
const brandLogos = brands.map((b) => ({ ...b, img: brandMods[`../../images/brands-mono/${b.file.replace(/\.\w+$/, '.png')}`] }));

// Har toifaga real do'kon fotosi biriktiriladi — qatorga kursor kelganda ko'rinadi.
const catPhotos = categories.map((c, i) => ({ ...c, img: photos[i % photos.length] }));

const nav = [
  { href: '#toifalar', label: 'Toifalar' },
  { href: '#nega-biz', label: 'Nega biz' },
  { href: '#brendlar', label: 'Brendlar' },
  { href: '#dokon', label: "Do'kon" },
  { href: '#ulgurji', label: 'Ulgurji' },
  { href: '#manzil', label: 'Manzil' },
  { href: '#savollar', label: 'Savollar' },
];
const mapSrc = `https://www.openstreetmap.org/export/embed.html?bbox=${site.coords.lng - 0.008}%2C${site.coords.lat - 0.004}%2C${site.coords.lng + 0.008}%2C${site.coords.lat + 0.004}&layer=mapnik`;
---

<Base
  variant="v2"
  title="Diyor Stroy — qurilish mollari katalogi, Samarqand"
  description="5000+ mahsulot turi: sement, gipsokarton, bo'yoq, santexnika, kafel, asbob. Xalil Sulton 150, Samarqand. Har kuni 07:00–20:00."
>
  <a class="skip" href="#toifalar">Kontentga o'tish</a>

  <div class="shell">
    <!-- ============ CHAP PANEL ============ -->
    <aside class="rail">
      <a class="rail__brand" href="/v2">
        <Image src={logoWhite} alt="Diyor Stroy" widths={[150, 300]} sizes="150px" />
      </a>

      <div class="rail__contact">
        <a class="rail__phone tnum" href={site.phoneHref}>{site.phone}</a>
        <span class="rail__status"><OpenStatus /></span>
        <div class="rail__buttons">
          <a class="btn" href={site.phoneHref}><Icon name="phone" size={17} /> Qo'ng'iroq</a>
          <a class="btn btn--ghost" href={site.telegram} target="_blank" rel="noopener">
            <Icon name="telegram" size={17} /> Telegram
          </a>
        </div>
      </div>

      <nav class="rail__nav" aria-label="Bo'limlar">
        <ol>
          {
            nav.map((n, i) => (
              <li>
                <a href={n.href}>
                  <span class="tnum">{String(i + 1).padStart(2, '0')}</span>
                  {n.label}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      <div class="rail__foot">
        <p>{site.address}</p>
        <p class="tnum">{site.hours} · har kuni</p>
        <a href={site.instagram} target="_blank" rel="noopener">{site.instagramHandle}</a>
      </div>
    </aside>

    <!-- ============ KONTENT ============ -->
    <main class="main">
      <!-- HERO -->
      <header class="hero">
        <div class="hero__top">
          <span>Samarqand · Oqmachit MFY</span>
          <span class="tnum">39.62 N · 66.99 E</span>
        </div>
        <h1>
          Qurilish<br />
          mollari<br />
          <em>ombori</em>
        </h1>
        <p class="hero__lead">
          Sement va gipsokartondan santexnika va asboblargacha — 5000+ mahsulot
          turi bitta manzilda. To'g'ridan-to'g'ri ishlab chiqaruvchidan olinadi,
          shuning uchun narx bozor narxidan past.
        </p>

        <dl class="ledger">
          {
            stats.map((s) => (
              <div>
                <dt>{s.label}</dt>
                <dd class="tnum">{s.value}</dd>
              </div>
            ))
          }
        </dl>

        <figure class="hero__band">
          <Image
            src={street}
            alt="Diyor Stroy do'koni, Xalil Sulton ko'chasi"
            widths={[720, 1280, 1920]}
            sizes="100vw"
            loading="eager"
            fetchpriority="high"
          />
          <figcaption>Xalil Sulton ko'chasi 150 — do'kon oldi</figcaption>
        </figure>
      </header>

      <!-- TOIFALAR: indeks jadval -->
      <section class="block" id="toifalar">
        <div class="block__head">
          <h2>Toifalar</h2>
          <p>Kerakli qatorni ayting — mavjudligini va narxni telefonda aytamiz.</p>
        </div>

        <ul class="index" data-index>
          {
            catPhotos.map((c, i) => (
              <li>
                <a href={site.phoneHref} data-row>
                  <span class="index__n tnum">{String(i + 1).padStart(2, '0')}</span>
                  <span class="index__title">{c.title}</span>
                  <span class="index__items">{c.items}</span>
                  <span class="index__go"><Icon name="arrow" size={17} /></span>
                  <Image class="index__img" src={c.img} alt="" widths={[240, 480]} sizes="240px" loading="lazy" />
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- NEGA BIZ -->
      <section class="block" id="nega-biz">
        <div class="block__head">
          <h2>Nega Diyor Stroy</h2>
          <p>To'rt sabab, hammasi tekshiriladigan fakt.</p>
        </div>
        <ol class="reasons">
          {
            advantages.map((a, i) => (
              <li data-reveal style={`--reveal-delay:${i * 70}ms`}>
                <span class="reasons__n tnum">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <h3>{a.title}</h3>
                  <p>{a.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <!-- STATISTIKA -->
      <section class="band" aria-label="Raqamlar">
        <ul>
          {
            stats.map((s) => (
              <li>
                <span class="band__v tnum">{s.value}</span>
                <span class="band__l">{s.label}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- BRENDLAR -->
      <section class="block" id="brendlar">
        <div class="block__head">
          <h2>Brendlar</h2>
          <p>15 ta rasmiy brend. Faqat sertifikatlangan mahsulot.</p>
        </div>
        <div class="ticker" aria-label="Brendlar ro'yxati">
          <div class="ticker__track">
            {
              [0, 1].map(() =>
                brandLogos.map((b) => (
                  <span class="ticker__item">
                    <Image src={b.img} alt={b.name} widths={[120, 240]} sizes="120px" loading="lazy" />
                  </span>
                )),
              )
            }
          </div>
        </div>
      </section>

      <!-- DO'KON -->
      <section class="block" id="dokon">
        <div class="block__head">
          <h2>Do'kon</h2>
          <p>Rastalar, ombor va mahsulotlar — haqiqiy fotolar.</p>
        </div>
        <ul class="mosaic">
          {
            photos.map((p, i) => (
              <li class={i === 0 || i === 5 ? 'is-tall' : ''} data-reveal style={`--reveal-delay:${(i % 3) * 70}ms`}>
                <Image src={p} alt="Diyor Stroy do'koni" widths={[420, 840]} sizes="(max-width: 900px) 100vw, 30vw" loading="lazy" />
              </li>
            ))
          }
        </ul>
      </section>

      <!-- ULGURJI -->
      <section class="block" id="ulgurji">
        <div class="block__head">
          <h2>Ulgurji va brigadalar</h2>
          <p>Katta hajm — alohida narx. Hajmni yozing, hisoblab qaytaramiz.</p>
        </div>

        <div class="wholesale">
          <div>
            <ul class="services">
              {
                services.map((s) => (
                  <li>
                    <h3>{s.title}</h3>
                    <p>{s.text}</p>
                  </li>
                ))
              }
            </ul>
            <p class="early">
              <Icon name="sunrise" size={22} />
              <span>07:00 da ochamiz — brigada ish boshlashidan oldin ulguradi.</span>
            </p>
          </div>

          <form class="form" name="ulgurji-v2" method="POST" data-netlify="true" netlify-honeypot="bot-field">
            <input type="hidden" name="form-name" value="ulgurji-v2" />
            <p class="hp"><label>Bo'sh qoldiring <input name="bot-field" /></label></p>
            <label>
              <span>Ismingiz</span>
              <input type="text" name="ism" required autocomplete="name" placeholder="Ism" />
            </label>
            <label>
              <span>Telefon</span>
              <input type="tel" name="telefon" required autocomplete="tel" placeholder="+998 __ ___ __ __" />
            </label>
            <label>
              <span>Nima kerak</span>
              <textarea name="sorov" rows="3" required placeholder="200 qop sement, 40 list gipsokarton…"></textarea>
            </label>
            <button class="btn" type="submit">Ulgurji so'rov yuborish <Icon name="arrow" size={17} /></button>
          </form>
        </div>
      </section>

      <!-- MANZIL -->
      <section class="block" id="manzil">
        <div class="block__head">
          <h2>Manzil</h2>
          <p>Xalil Sulton ko'chasi 150, Oqmachit MFY, Samarqand.</p>
        </div>
        <div class="map">
          <iframe src={mapSrc} title="Diyor Stroy xaritada" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
          <span class="map__pin" aria-hidden="true"></span>
          <div class="map__card">
            <ul>
              <li><Icon name="pin" size={18} /><span>{site.address}</span></li>
              <li><Icon name="clock" size={18} /><span class="tnum">{site.hours} · {site.hoursNote}</span></li>
              <li><Icon name="phone" size={18} /><a href={site.phoneHref} class="tnum">{site.phone}</a></li>
              <li><Icon name="tag" size={18} /><span>{site.payments.join(' · ')}</span></li>
            </ul>
            <div class="map__links">
              <a class="btn btn--ghost" href={site.googleMaps} target="_blank" rel="noopener">Google Maps</a>
              <a class="btn btn--ghost" href={site.yandexMaps} target="_blank" rel="noopener">Yandex</a>
            </div>
          </div>
        </div>
      </section>

      <!-- SAVOLLAR -->
      <section class="block" id="savollar">
        <div class="block__head">
          <h2>Savollar</h2>
          <p>Eng ko'p so'raladiganlari.</p>
        </div>
        <ul class="faq">
          {
            faq.map((f) => (
              <li>
                <details>
                  <summary><span>{f.q}</span><i aria-hidden="true"></i></summary>
                  <p>{f.a}</p>
                </details>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- CTA -->
      <section class="cta">
        <h2>Narxni telefonda aytamiz</h2>
        <p>Nima kerakligini ayting — mavjudligi va aniq narxi bir daqiqada ma'lum bo'ladi.</p>
        <div class="cta__row">
          <a class="btn btn--big" href={site.phoneHref}><span class="tnum">{site.phone}</span> <Icon name="arrow" size={20} /></a>
          <a class="btn btn--ghost btn--big" href={site.telegram} target="_blank" rel="noopener"><Icon name="telegram" size={18} /> Telegram</a>
        </div>
      </section>

      <footer class="footer">
        <span>© {new Date().getFullYear()} Diyor Stroy · Samarqand</span>
        <span>{site.address}</span>
        <a href={site.instagram} target="_blank" rel="noopener">{site.instagramHandle}</a>
      </footer>
    </main>
  </div>

  <div class="mobilebar">
    <a href={site.phoneHref}><Icon name="phone" size={19} /> Qo'ng'iroq</a>
    <a href={site.telegram} target="_blank" rel="noopener"><Icon name="telegram" size={19} /> Telegram</a>
  </div>
</Base>

<style is:global>
  body.variant-v2 {
    --display: 'Archivo Variable', 'Inter Variable', sans-serif;
    background: var(--color-bg-900);
  }
</style>

<style>
  .skip {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 200;
    padding: 12px 18px;
    background: var(--color-accent);
    color: #fff;
  }
  .skip:focus { left: 12px; top: 12px; }

  .shell {
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr);
    min-height: 100svh;
  }

  /* ================= CHAP PANEL ================= */
  .rail {
    position: sticky;
    top: 0;
    align-self: start;
    height: 100svh;
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding: 32px 28px;
    border-right: 1px solid var(--line);
    background: var(--color-bg-800);
  }
  .rail__brand img { width: auto; height: 64px; }

  .rail__phone {
    display: block;
    font-family: var(--display);
    font-variation-settings: 'wdth' 112;
    font-size: 25px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-fg-100);
    transition: color 0.2s var(--ease-out-expo);
  }
  .rail__phone:hover { color: var(--color-accent-hot); }
  .rail__status { display: block; margin-top: 10px; }

  .rail__buttons {
    display: grid;
    gap: 8px;
    margin-top: 18px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    min-height: 48px;
    padding: 13px 20px;
    background: var(--color-accent);
    color: #fff;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: background 0.2s var(--ease-out-expo), border-color 0.2s var(--ease-out-expo);
  }
  .btn :global(svg) { transition: transform 0.2s var(--ease-out-expo); }
  .btn:hover { background: var(--color-accent-hot); }
  .btn:hover :global(svg) { transform: translateX(3px); }
  .btn--ghost {
    background: transparent;
    color: var(--color-fg-100);
    border: 1px solid var(--line);
  }
  .btn--ghost:hover { background: transparent; border-color: var(--color-fg-100); }
  .btn--big { min-height: 60px; font-size: 14px; padding-inline: 28px; }

  .rail__nav { margin-top: 4px; flex: 1; }
  .rail__nav ol { display: grid; gap: 1px; }
  .rail__nav a {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 9px 0;
    font-size: 15px;
    color: var(--color-fg-300);
    border-bottom: 1px solid var(--line-2);
    transition: color 0.2s var(--ease-out-expo), padding-left 0.2s var(--ease-out-expo);
  }
  .rail__nav a span {
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--color-fg-500);
  }
  .rail__nav a:hover {
    color: var(--color-fg-100);
    padding-left: 6px;
  }

  .rail__foot {
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-fg-500);
    display: grid;
    gap: 6px;
  }
  .rail__foot a { color: var(--color-fg-300); }
  .rail__foot a:hover { color: var(--color-accent-hot); }

  /* ================= KONTENT ================= */
  .main { min-width: 0; }

  .block {
    padding: clamp(56px, 7vw, 104px) clamp(24px, 4vw, 72px);
    border-top: 1px solid var(--line-2);
  }
  .block__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: clamp(28px, 4vw, 48px);
  }
  .block__head h2 {
    font-family: var(--display);
    font-variation-settings: 'wdth' 118;
    font-size: clamp(28px, 3.4vw, 44px);
    font-weight: 600;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--color-fg-100);
  }
  .block__head p {
    max-width: 46ch;
    font-size: 15px;
    color: var(--color-fg-500);
  }

  /* ---------- HERO ---------- */
  .hero { padding: clamp(28px, 4vw, 56px) clamp(24px, 4vw, 72px) 0; }
  .hero__top {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 22px;
    border-bottom: 1px solid var(--line);
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-fg-500);
  }
  .hero h1 {
    margin-top: clamp(28px, 4vw, 48px);
    font-family: var(--display);
    font-variation-settings: 'wdth' 125;
    font-size: clamp(48px, 9.5vw, 132px);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.035em;
    text-transform: uppercase;
    color: var(--color-fg-100);
  }
  .hero h1 em {
    font-style: normal;
    color: var(--color-accent);
  }
  .hero__lead {
    margin-top: 28px;
    max-width: 62ch;
    font-size: clamp(16px, 1.3vw, 19px);
    color: var(--color-fg-300);
  }

  .ledger {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: clamp(36px, 5vw, 56px) 0 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .ledger > div {
    padding: 20px 20px 20px 0;
    border-right: 1px solid var(--line-2);
  }
  .ledger > div:last-child { border-right: 0; }
  .ledger > div:not(:first-child) { padding-left: 20px; }
  .ledger dt {
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-fg-500);
  }
  .ledger dd {
    margin: 10px 0 0;
    font-family: var(--display);
    font-variation-settings: 'wdth' 112;
    font-size: clamp(28px, 3.2vw, 42px);
    font-weight: 600;
    line-height: 1;
    color: var(--color-fg-100);
  }

  .hero__band {
    margin: clamp(32px, 4vw, 48px) calc(-1 * clamp(24px, 4vw, 72px)) 0;
    position: relative;
  }
  .hero__band img {
    width: 100%;
    height: clamp(220px, 34vw, 420px);
    object-fit: cover;
    filter: contrast(1.08) saturate(0.62) brightness(0.72);
  }
  .hero__band figcaption {
    position: absolute;
    left: clamp(24px, 4vw, 72px);
    bottom: 18px;
    padding: 9px 14px;
    background: rgb(10 10 11 / 0.7);
    backdrop-filter: blur(10px);
    border: 1px solid var(--line);
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--color-fg-300);
  }

  /* ---------- INDEKS JADVAL ---------- */
  .index { border-top: 1px solid var(--line); }
  .index li { border-bottom: 1px solid var(--line-2); }
  .index a {
    position: relative;
    display: grid;
    grid-template-columns: 64px minmax(0, 1.1fr) minmax(0, 1fr) 48px;
    align-items: center;
    gap: 16px;
    padding: 20px 0;
    overflow: hidden;
    transition: padding-left 0.35s var(--ease-out-expo), background 0.35s var(--ease-out-expo);
  }
  .index a:hover,
  .index a:focus-visible {
    padding-left: 20px;
    background: linear-gradient(90deg, rgb(228 87 46 / 0.1), transparent 55%);
  }
  .index__n {
    font-size: 12px;
    letter-spacing: 0.14em;
    color: var(--color-fg-500);
    transition: color 0.25s var(--ease-out-expo);
  }
  .index a:hover .index__n { color: var(--color-accent); }
  .index__title {
    font-family: var(--display);
    font-variation-settings: 'wdth' 108;
    font-size: clamp(19px, 2vw, 26px);
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--color-fg-100);
  }
  .index__items { font-size: 15px; color: var(--color-fg-500); }
  .index__go {
    justify-self: end;
    color: var(--color-fg-500);
    transform: translateX(-8px);
    opacity: 0;
    transition: transform 0.3s var(--ease-out-expo), opacity 0.3s var(--ease-out-expo);
  }
  .index a:hover .index__go { opacity: 1; transform: none; color: var(--color-accent-hot); }

  .index__img {
    position: absolute;
    right: 72px;
    top: 50%;
    width: 150px;
    height: 96px;
    object-fit: cover;
    border-radius: 8px;
    opacity: 0;
    transform: translate(0, -46%) rotate(-2.5deg) scale(0.92);
    filter: contrast(1.05) saturate(0.7) brightness(0.9);
    transition: opacity 0.35s var(--ease-out-expo), transform 0.45s var(--ease-out-expo);
    pointer-events: none;
  }
  .index a:hover .index__img {
    opacity: 1;
    transform: translate(0, -50%) rotate(-2.5deg) scale(1);
  }

  /* ---------- SABABLAR ---------- */
  .reasons {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    border-top: 1px solid var(--line);
  }
  .reasons li {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 18px;
    padding: 28px 32px 28px 0;
    border-bottom: 1px solid var(--line-2);
  }
  .reasons li:nth-child(odd) { border-right: 1px solid var(--line-2); }
  .reasons li:nth-child(even) { padding-left: 32px; }
  .reasons__n {
    font-family: var(--display);
    font-variation-settings: 'wdth' 110;
    font-size: 30px;
    font-weight: 600;
    line-height: 1;
    color: var(--color-accent);
  }
  .reasons h3 { font-size: 19px; font-weight: 600; }
  .reasons p { margin-top: 8px; font-size: 15px; color: var(--color-fg-300); }

  /* ---------- BAND ---------- */
  .band { background: var(--color-accent); }
  .band ul {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    padding: 0 clamp(24px, 4vw, 72px);
  }
  .band li {
    padding: clamp(28px, 4vw, 52px) 20px;
    border-left: 1px solid rgb(255 255 255 / 0.22);
  }
